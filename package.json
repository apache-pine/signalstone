{
	"name": "signalstone",
	"version": "1.1.1",
	"description": "A lightweight Webex messaging client for the Obsidian sidebar.",
	"main": "main.js",
	"type": "module",
	"author": {
		"name": "apache-pine",
		"url": "https://github.com/apache-pine"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/apache-pine/signalstone.git"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"obsidian",
		"webex",
		"messaging"
	],
	"license": "MIT",
	"devDependencies": {
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.1.0",
		"@types/node": "^22.15.17",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.3",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.7.0",
		"jsdom": "^25.0.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.0.5"
	},
	"dependencies": {
		"@babel/runtime-corejs2": "7.29.2",
		"@webex/plugin-logger": "3.7.0",
		"@webex/plugin-memberships": "3.7.0",
		"@webex/plugin-messages": "3.7.0",
		"@webex/plugin-people": "3.7.0",
		"@webex/plugin-rooms": "3.7.0",
		"@webex/webex-core": "3.7.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	}
}
